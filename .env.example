GEMINI_API_KEY=
# Set a Gemini vision model available to your API project.
GEMINI_MODEL=gemini-3.5-flash
PPE_MODEL_PATH=models/best.pt
PERSON_MODEL=yolo11n.pt
PPE_CONFIDENCE_THRESHOLD=0.25
PERSON_CONFIDENCE_THRESHOLD=0.25
VLM_CACHE_TTL=30
VLM_FAILURE_COOLDOWN=5
GEMINI_MAX_RETRIES=2
INPUT_VIDEO=video_test/video_test2.mp4
OUTPUT_VIDEO=outputs/context_agent_output.mp4
# Pixel coordinates in the input video's original resolution; boundary is inside.
RESTRICTED_ZONE=[[100,100],[500,100],[550,400],[80,400]]
LOG_INTERVAL=1
JSON_LOG_INTERVAL=10

# LangSmith Observability & Evaluation Tracing (Optional)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=diraya-safety-agent
