GEMINI_API_KEY=
# Set a Gemini vision model available to your API project.
GEMINI_MODEL=gemini-3.8-flash
PPE_MODEL_PATH=models/PPE.pt
FALL_MODEL_PATH=models/Fall.pt
PERSON_MODEL=models/yolo11n.pt
PPE_CONFIDENCE_THRESHOLD=0.40
FALL_CONFIDENCE_THRESHOLD=0.40
PERSON_CONFIDENCE_THRESHOLD=0.40
VLM_CACHE_TTL=30
VLM_FAILURE_COOLDOWN=5
GEMINI_MAX_RETRIES=2
INPUT_VIDEO=video_test/video_test2.mp4
OUTPUT_VIDEO=outputs/context_agent_output.mp4
# Frames are resized to this resolution before all inference and output encoding.
PROCESSING_WIDTH=640
PROCESSING_HEIGHT=360
# Pixel coordinates in the processing resolution; boundary is inside.
RESTRICTED_ZONE=[[100,100],[500,100],[550,400],[80,400]]
LOG_INTERVAL=1
JSON_LOG_INTERVAL=10
# Stable real-world zone assigned to alerts from this camera/video source.
FACILITY_ZONE=Welding Area

# LangSmith Observability & Evaluation Tracing (Optional)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=diraya-safety-agent

# Safety Chat Assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
